<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.10">
  <world name="aruco_world">
    <!-- Physics -->
    <plugin name="ignition::gazebo::Systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::Systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::Systems::SceneManager" filename="ignition-gazebo-scene-manager-system"/>
    <plugin name="ignition::gazebo::Systems::Rendering" filename="ignition-gazebo-rendering-system"/>
    <plugin name="ignition::gazebo::Systems::Contact" filename="ignition-gazebo-contact-system"/>
    
    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>
    
    <!-- Magnetic field -->
    <magnetic_field>0.00000650 0.00000750 -0.00054160</magnetic_field>
    
    <!-- Atmosphere model -->
    <atmosphere type="adiabatic"/>
    
    <!-- Scene -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- Light -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ArUco marker model -->
    <model name="aruco_marker_0">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://aruco_marker</uri>
      </include>
    </model>
  </world>
</sdf>
